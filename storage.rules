rules_version = '2';

// Fotos de las tareas (Firebase Storage).
// Suben fotos: Fran y su hermano. Las ven: ellos y el encargado (app espejo).
service firebase.storage {
  match /b/{bucket}/o {
    function autorizado() {
      return request.auth != null && request.auth.uid in [
        'seq3CISgWIdOMnRGH2QAXvSHDyw1', // Fran
        'LHagvsoFmJU9jHOV9TilSCY81r92'  // hermano de Fran
      ];
    }
    function encargado() {
      return request.auth != null && request.auth.uid in [
        'a3RUHr2UIQVpM2w4eleC8GE7lZ53', // encargado (Fabio)
        'zuo3LqOv04NJFIwSbJt7cWpifk82'  // Mory (trabajador)
      ];
    }
    match /fotos/{archivo} {
      allow read: if autorizado() || encargado();
      allow create: if autorizado()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if autorizado();
    }
  }
}
