rules_version = '2';

// Reglas para la Pizarra de Tareas.
// Solo pueden leer y escribir las cuentas autorizadas (correo y contraseña).
// Para autorizar a otra persona: crear su cuenta en Firebase > Authentication
// y añadir aquí su identificador (UID).
// Los usuarios de la espejo (encargado y trabajadores autorizados) tienen su cuenta y SOLO pueden LEER
// las tareas de la pizarra, las fincas y los trabajadores.
// Las tareas personales de Fran y de su hermano (privadas/{uid}) solo las ve su dueño.
service cloud.firestore {
  match /databases/{database}/documents {

    function esUsuarioAutorizado() {
      return request.auth != null && request.auth.uid in [
        'seq3CISgWIdOMnRGH2QAXvSHDyw1', // Fran
        'LHagvsoFmJU9jHOV9TilSCY81r92'  // hermano de Fran
      ];
    }

    function esEncargado() {
      return request.auth != null && request.auth.uid in [
        'a3RUHr2UIQVpM2w4eleC8GE7lZ53', // encargado (Fabio)
        'zuo3LqOv04NJFIwSbJt7cWpifk82'  // Mory (trabajador)
      ];
    }

    // Todo lo de la pizarra, salvo las tareas personales (privadas), que van aparte.
    match /artifacts/ecologicos-almeria-v1/{coleccion}/{resto=**} {
      allow read, write: if esUsuarioAutorizado() && coleccion != 'privadas';
    }

    // Tareas personales: cada uno solo ve y cambia las suyas.
    match /artifacts/ecologicos-almeria-v1/privadas/{uid}/{resto=**} {
      allow read, write: if esUsuarioAutorizado() && request.auth.uid == uid;
    }

    // Solo lectura para el encargado (app espejo). 'publicados' = qué días ha publicado Fran y qué ha cambiado.
    match /artifacts/ecologicos-almeria-v1/{coleccion}/{id} {
      allow read: if esEncargado() && coleccion in ['board', 'fincas', 'workers', 'publicados'];
    }

    // Cada cuenta de la espejo guarda y lee SOLO su propio aparato para las notificaciones.
    match /artifacts/ecologicos-almeria-v1/avisos/{uid} {
      allow read, write: if esEncargado() && request.auth.uid == uid;
    }

  }
}
